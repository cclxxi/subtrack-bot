{
  "name": "subs-bot",
  "license": "GPL-3.0",
  "description": "Telegram bot for managing subscriptions and sending notifications",
  "author": "cclxxi",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc",
    "dev": "bun run build && bun run start",
    "start": "bun src/index.ts",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run ./src/infra/database/drizzle/migration.runner.ts",
    "db:seed": "bun run ./src/infra/database/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:validate": "drizzle-kit check"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.20.0",
    "prettier": "^3.8.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@grammyjs/conversations": "^2.1.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "croner": "^10.0.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "grammy": "^1.43.0",
    "hono": "^4.12.23",
    "pg": "^8.21.0",
    "zod": "^4.4.3"
  }
}
