NODE_ENV=development
PORT=3000

# Telegram
BOT_TOKEN=
BOT_MODE=polling
# Required when BOT_MODE=webhook (production):
# BOT_WEBHOOK_URL=https://subs-bot.example.com/tg/webhook
# BOT_WEBHOOK_SECRET=<32+ random chars, e.g. `openssl rand -hex 32`>

# Telegram Mini App (WebApp)
# Public HTTPS origin where the Mini App is served (used for the menu button).
# WEBAPP_URL=https://subs-bot.example.com
# Set true in production to serve web/dist from this server (single origin).
SERVE_WEBAPP=false

# PostgreSQL
# For `bun run start` from the host → DATABASE_HOST=localhost
# For `docker compose up` → docker-compose overrides this to `subs-bot-db`
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=subs_bot
DATABASE_SSL=false

# Misc
TZ_DEFAULT=Europe/Moscow
DRIZZLE_OUT=./drizzle
